{
  "name": "tasktrack",
  "version": "1.0.0",
  "description": "Task tracking app",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint src tests",
    "test": "jest tests/unit",
    "test:integration": "jest tests/integration"
  },
  "jest": {
    "testEnvironment": "node",
    "reporters": [
      "default",
      "jest-junit"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 80,
        "functions": 80,
        "lines": 80
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wkinc/tasktrack.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wkinc/tasktrack/issues"
  },
  "homepage": "https://github.com/wkinc/tasktrack#readme",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.2"
  }
}